<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Esquema MySQL dedicado, no SQLite. Las migraciones declaran
            `collate 'utf8mb4_unicode_ci'` en cada columna de texto y SQLite responde
            `no such collation sequence`, así que ahí no corre ni la migración de
            `grafemas`. Además el cotejamiento es parte de lo que hay que probar
            (`x` y `ẍ` son iguales para MySQL), y SQLite daría falsa confianza.

            Crear el esquema una vez:
              create database aprende_mam_testing
                character set utf8mb4 collate utf8mb4_unicode_ci;

            `force="true"` para que un DB_DATABASE del .env no se filtre a los tests:
            RefreshDatabase borraría la base de desarrollo. TestCase lo vuelve a
            comprobar en tiempo de ejecución.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="aprende_mam_testing" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
